/* Hallmark · pre-emit critique: P5 H4 E5 S5 R5 V4 */
/* VeraCore professional workstation shell · all colors resolve through DawTheme tokens. */

QToolTip{
  color:@vc-text-primary;
  background-color:@vc-surface-0;
  border:1px solid @vc-accent;
  border-radius:@vc-radius-small;
  padding:2px 6px;
}
QStatusBar{
  background-color:@vc-surface-0;
  border-top:1px solid @vc-border-strong;
  color:@vc-text-muted;
}

/* Persistent plugin-health badges shared by instrument layers and audio FX. */
QLabel#pluginStatusBadge{
  border:1px solid @vc-border-strong;
  border-radius:2px;
  padding:1px 4px;
  font-size:8px;
  font-weight:bold;
}
QLabel#pluginStatusBadge[hostStatus="active"]{
  color:@vc-success;
  background-color:@vc-success-bg;
}
QLabel#pluginStatusBadge[hostStatus="pending"]{
  color:@vc-warning;
  background-color:@vc-warning-bg;
}
QLabel#pluginStatusBadge[hostStatus="failed"]{
  color:@vc-danger;
  background-color:@vc-danger-bg;
}
QLabel#pluginStatusBadge[hostStatus="faulted"]{
  color:@vc-warning;
  background-color:@vc-warning-bg;
  border-color:@vc-warning-border;
}
QLabel#audioMediaStatus{
  color:@vc-success;
  background-color:@vc-success-bg;
  border:1px solid @vc-border-strong;
  border-radius:@vc-radius-small;
  padding:5px 7px;
  font-weight:700;
}
QLabel#audioMediaStatus[mediaOffline="true"]{
  color:@vc-danger;
  background-color:@vc-danger-bg;
  border-color:@vc-danger;
}
QLabel#pluginStatusBadge[hostStatus="unsupported"]{
  color:@vc-danger;
  background-color:@vc-danger-bg;
}
QFrame#MidiToolbarDivider{
  background-color:@vc-border;
  border:none;
}
QMenuBar{
  background-color:@vc-surface-0;
  border-bottom:1px solid @vc-border-strong;
}
QMenuBar::item{
  spacing:2px;
  padding:4px 10px;
  background:transparent;
  color:@vc-text-secondary;
}
QMenuBar::item:selected{
  background-color:@vc-surface-2;
  color:@vc-text-bright;
}
QMenuBar::item:pressed{
  background-color:@vc-accent;
  color:@vc-accent-ink;
}
QMenu{
  background-color:@vc-surface-1;
  border:1px solid @vc-border-strong;
  padding:3px;
}
QMenu::item{
  padding:4px 25px 4px 25px;
  border:1px solid transparent;
  border-radius:2px;
  color:@vc-text-primary;
}
QMenu::item:disabled{
  color:@vc-disabled;
}
QMenu::item:selected{
  background-color:@vc-accent;
  color:@vc-accent-ink;
}
QMenu::separator{
  height:1px;
  background:@vc-border;
  margin:3px 8px;
}
QMenu::indicator{
  width:18px;
  height:18px;
}
QMenu::indicator:non-exclusive:checked{
  image:url(:/darkstyle/icon_checkbox_checked.png);
  padding-left:2px;
}
QMenu::indicator:non-exclusive:unchecked{
  image:url(:/darkstyle/icon_checkbox_unchecked.png);
  padding-left:2px;
}
QMenu::indicator:exclusive:checked{
  image:url(:/darkstyle/icon_radiobutton_checked.png);
  padding-left:2px;
}
QMenu::indicator:exclusive:unchecked{
  image:url(:/darkstyle/icon_radiobutton_unchecked.png);
  padding-left:2px;
}
QMainWindow::separator{
  width:4px;
  height:4px;
  background:@vc-canvas;
}
QSplitter::handle{
  background:@vc-canvas;
}
QSplitter::handle:horizontal{
  width:@vc-splitter-size;
}
QSplitter::handle:vertical{
  height:@vc-splitter-size;
}
QMainWindow::separator:hover,QSplitter::handle:hover{
  background:@vc-accent;
}

/* Browser panel (left column) */
#browserPanel{
  background-color:@vc-surface-0;
  border-right:1px solid @vc-border-strong;
}
#browserHeader{
  color:@vc-text-secondary;
  font-size:10px;
  font-weight:bold;
  padding:5px 7px 3px 7px;
  background-color:@vc-surface-0;
}
#browserSearch{
  margin:0px 5px 5px 5px;
}
#trackHeadersContainer{
  background-color:@vc-surface-0;
}

QLineEdit{
  background-color:@vc-canvas;
  color:@vc-text-primary;
  border:1px solid @vc-border-strong;
  border-radius:@vc-radius-small;
  padding:4px 6px;
  selection-background-color:@vc-accent;
  selection-color:@vc-accent-ink;
}
QLineEdit:focus{
  border:1px solid @vc-accent;
}
QComboBox:focus,QSpinBox:focus,QDoubleSpinBox:focus,QPushButton:focus,QToolButton:focus{
  border:1px solid @vc-accent;
}

QDockWidget::title{
  padding:4px;
  background-color:@vc-surface-0;
  border:1px solid @vc-border-strong;
}
QDockWidget{
  titlebar-close-icon:url(:/darkstyle/icon_close.png);
  titlebar-normal-icon:url(:/darkstyle/icon_restore.png);
}
QDockWidget::close-button,QDockWidget::float-button{
  subcontrol-position:top right;
  subcontrol-origin:margin;
  position:absolute;
  top:3px;
  bottom:0px;
  width:20px;
  height:20px;
}
QDockWidget::close-button{
  right:3px;
}
QDockWidget::float-button{
  right:25px;
}
QGroupBox{
  background-color:transparent;
  margin-top:14px;
  border:1px solid @vc-border;
  border-radius:@vc-radius-small;
}
QGroupBox::title{
  subcontrol-origin:margin;
  subcontrol-position:left top;
  padding:0px 4px;
  margin-left:6px;
  color:@vc-text-muted;
  background-color:transparent;
}
QTabWidget::pane{
  background-color:@vc-surface-1;
  border:1px solid @vc-border-strong;
}
QTabWidget::tab-bar{
  left:3px;
  top:1px;
}
QTabBar{
  background-color:transparent;
  qproperty-drawBase:0;
  border-bottom:1px solid @vc-border-strong;
}
QTabBar::tab{
  padding:5px 12px;
  background-color:@vc-surface-0;
  border:1px solid @vc-border-strong;
  border-top-left-radius:3px;
  border-top-right-radius:3px;
  color:@vc-text-muted;
}
QTabBar::tab:selected,QTabBar::tab:hover{
  background-color:@vc-surface-2;
  color:@vc-text-primary;
}
QTabBar::tab:selected{
  border-bottom:2px solid @vc-accent;
}
QTabBar::tab::selected:disabled{
  border-bottom:2px solid @vc-disabled;
}
QTabBar::tab:!selected{
  margin-top:2px;
}
QTabBar::close-button {
  image:url(:/darkstyle/icon_close.png);
  border:1px solid transparent;
  border-radius:2px;
}
QTabBar::close-button:hover {
  background-color:@vc-border;
}
QTabBar::close-button:pressed {
  background-color:@vc-surface-0;
}
QCheckBox::indicator{
  width:18px;
  height:18px;
}
QCheckBox::indicator:checked,QTreeView::indicator:checked,QTableView::indicator:checked,QGroupBox::indicator:checked{
  image:url(:/darkstyle/icon_checkbox_checked.png);
}
QCheckBox::indicator:checked:pressed,QTreeView::indicator:checked:pressed,QTableView::indicator:checked:pressed,QGroupBox::indicator:checked:pressed{
  image:url(:/darkstyle/icon_checkbox_checked_pressed.png);
}
QCheckBox::indicator:checked:disabled,QTreeView::indicator:checked:disabled,QTableView::indicator:checked:disabled,QGroupBox::indicator:checked:disabled{
  image:url(:/darkstyle/icon_checkbox_checked_disabled.png);
}
QCheckBox::indicator:unchecked,QTreeView::indicator:unchecked,QTableView::indicator:unchecked,QGroupBox::indicator:unchecked{
  image:url(:/darkstyle/icon_checkbox_unchecked.png);
}
QCheckBox::indicator:unchecked:pressed,QTreeView::indicator:unchecked:pressed,QTableView::indicator:unchecked:pressed,QGroupBox::indicator:unchecked:pressed{
  image:url(:/darkstyle/icon_checkbox_unchecked_pressed.png);
}
QCheckBox::indicator:unchecked:disabled,QTreeView::indicator:unchecked:disabled,QTableView::indicator:unchecked:disabled,QGroupBox::indicator:unchecked:disabled{
  image:url(:/darkstyle/icon_checkbox_unchecked_disabled.png);
}
QCheckBox::indicator:indeterminate,QTreeView::indicator:indeterminate,QTableView::indicator:indeterminate,QGroupBox::indicator:indeterminate{
  image:url(:/darkstyle/icon_checkbox_indeterminate.png);
}
QCheckBox::indicator:indeterminate:pressed,QTreeView::indicator:indeterminate:pressed,QTableView::indicator:indeterminate:pressed,QGroupBox::indicator:indeterminate:pressed{
  image:url(:/darkstyle/icon_checkbox_indeterminate_pressed.png);
}
QCheckBox::indicator:indeterminate:disabled,QTreeView::indicator:indeterminate:disabled,QTableView::indicator:indeterminate:disabled,QGroupBox::indicator:indeterminate:disabled{
  image:url(:/darkstyle/icon_checkbox_indeterminate_disabled.png);
}
QRadioButton::indicator{
  width:18px;
  height:18px;
}
QRadioButton::indicator:checked{
  image:url(:/darkstyle/icon_radiobutton_checked.png);
}
QRadioButton::indicator:checked:pressed{
  image:url(:/darkstyle/icon_radiobutton_checked_pressed.png);
}
QRadioButton::indicator:checked:disabled{
  image:url(:/darkstyle/icon_radiobutton_checked_disabled.png);
}
QRadioButton::indicator:unchecked{
  image:url(:/darkstyle/icon_radiobutton_unchecked.png);
}
QRadioButton::indicator:unchecked:pressed{
  image:url(:/darkstyle/icon_radiobutton_unchecked_pressed.png);
}
QRadioButton::indicator:unchecked:disabled{
  image:url(:/darkstyle/icon_radiobutton_unchecked_disabled.png);
}
QTreeView, QTableView{
  alternate-background-color:transparent;
  background:transparent;
  border:none;
  outline:none;
}
QTreeView::item{
  min-height:@vc-tree-row-height;
  padding:2px 2px;
  border:none;
  color:@vc-text-secondary;
}
QTreeView::item:hover, QTableView::item:hover{
  background:@vc-surface-2;
  color:@vc-text-bright;
}
QTreeView::item:selected, QTableView::item:selected{
  background:@vc-selection;
  color:@vc-accent-hover;
}
QTreeView::item:selected:disabled, QTableView::item:selected:disabled{
  background:@vc-border;
}
QTreeView QHeaderView::section, QTableView QHeaderView::section{
  background-color:@vc-surface-0;
  color:@vc-text-muted;
  border-style:none;
  border-bottom:1px solid @vc-border-strong;
  padding-left:5px;
  padding-right:5px;
}
QTreeView::branch{
  background-color:transparent;
  width:12px;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings{
  border-image:none;
  image:url(:/darkstyle/icon_branch_closed.png);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings{
  border-image:none;
  image:url(:/darkstyle/icon_branch_open.png);
}
QScrollBar:vertical{
  background:transparent;
  width:@vc-scrollbar-size;
  margin:0px;
}
QScrollBar::handle:vertical{
  background-color:@vc-scrollbar;
  border-radius:@vc-radius-small;
  min-height:24px;
  margin:2px 3px;
}
QScrollBar::handle:vertical:hover{
  background-color:@vc-accent;
}
QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical{
  background:none;
  height:0px;
}
QScrollBar::add-page:vertical,QScrollBar::sub-page:vertical{
  background:transparent;
}
QScrollBar:horizontal{
  background:transparent;
  height:@vc-scrollbar-size;
  margin:0px;
}
QScrollBar::handle:horizontal{
  background-color:@vc-scrollbar;
  border-radius:@vc-radius-small;
  min-width:24px;
  margin:3px 2px;
}
QScrollBar::handle:horizontal:hover{
  background-color:@vc-accent;
}
QScrollBar::add-line:horizontal,QScrollBar::sub-line:horizontal{
  background:none;
  width:0px;
}
QScrollBar::add-page:horizontal,QScrollBar::sub-page:horizontal{
  background:transparent;
}
QSlider::handle:horizontal{
  border-radius:4px;
  border:1px solid @vc-border-strong;
  background-color:@vc-scrollbar;
  min-height:20px;
  margin:0 -4px;
}
QSlider::handle:horizontal:hover{
  background:@vc-accent;
}
QSlider::add-page:horizontal{
  background:@vc-surface-0;
}
QSlider::sub-page:horizontal{
  background:@vc-disabled;
}
QSlider::sub-page:horizontal:disabled{
  background:@vc-border;
}

